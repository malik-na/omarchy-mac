#!/bin/bash

# omarchy:summary=Lock the screen on boot, once the display is ready (Apple Silicon safe)
# omarchy:group=system
# omarchy:name=lock-on-boot
#
# The Mac fork locks the screen on startup for security: an Asahi ALARM /
# Omarchy install is unencrypted by default, so the boot lock is the only
# at-rest protection those users have.
#
# Locking straight from autostart races two things on Apple Silicon: GPU/DRM
# init, which leaves a blank lock surface, and the shell's lock plugin, which
# refuses requests until its PAM config has loaded.

# An encrypted machine has already authenticated its owner: the disk passphrase
# was typed at boot, minutes ago, and the screen lock asks for the same person's
# password again to protect a machine they are sitting in front of. This is the
# reasoning the ISO already applies to autologin on encrypted installs -- the
# boot lock exists for unencrypted ones, which have no at-rest protection at
# all. OMARCHY_LOCK_ON_BOOT=1 forces it back on.
root_is_encrypted() {
  local source
  source=$(findmnt -no SOURCE / 2>/dev/null | sed 's/\[.*\]//')
  [[ $(lsblk -no TYPE "$source" 2>/dev/null) == "crypt" ]]
}

if [[ ${OMARCHY_LOCK_ON_BOOT:-0} != "1" ]] && root_is_encrypted; then
  exit 0
fi

lock_state() {
  OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell lock status 2>/dev/null |
    jq -r 'if .secure == true then "secure" elif .requested == true then "locking" else "idle" end' 2>/dev/null
}

# Wait up to ~10s for a monitor with a non-zero resolution to appear.
for _ in $(seq 1 100); do
  hyprctl monitors 2>/dev/null | grep -qE '[0-9]+x[0-9]+@' && break
  sleep 0.1
done

# Let the GPU/DRM settle the first frame before creating the lock surface.
sleep 2

# Re-request until the lock takes: a fresh shell answers before its lock plugin
# can serve, so a single request is silently dropped.
deadline=$((SECONDS + 30))
while ((SECONDS < deadline)); do
  case "$(lock_state)" in
    secure) exit 0 ;;
    locking) ;;
    *) omarchy-system-lock >/dev/null 2>&1 ;;
  esac
  sleep 0.2
done

echo "Timed out waiting for the session to lock on boot." >&2
exit 1
