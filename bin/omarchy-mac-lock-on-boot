#!/bin/bash

# omarchy-mac:summary=Lock the screen on boot, once the display is ready (Apple Silicon safe)
# omarchy-mac:group=system
# omarchy-mac:name=lock-on-boot
#
# The Mac fork locks the screen on startup for security: an Asahi ALARM /
# Omarchy install is unencrypted by default, so the boot lock is the only
# at-rest protection those users have.
#
# Running `hyprlock` directly from autostart races GPU/DRM init on Apple
# Silicon: it creates the ext-session-lock surface before the first frame is
# ready, renders a blank/frozen screen, and (if it dies) orphans the lock so no
# password prompt can be shown. Wait for Hyprland to report a monitor with a
# real mode, let the first frame settle, then lock.

# Already locked (re-entrant / manual lock beat us to it)? Do nothing.
pidof hyprlock >/dev/null && exit 0

# Wait up to ~10s for a monitor with a non-zero resolution to appear.
for _ in $(seq 1 100); do
  hyprctl monitors 2>/dev/null | grep -qE '[0-9]+x[0-9]+@' && break
  sleep 0.1
done

# Let the GPU/DRM settle the first frame before creating the lock surface.
# (This delay, not the monitor probe, is what the original bare `hyprlock` was
# missing on Apple Silicon.)
sleep 2

exec hyprlock
