#!/bin/bash

# omarchy:summary=Pick a theme background with a large right-side image preview
# omarchy:group=menu
# omarchy:name=backgrounds
#
# Walker/Elephant showed a big preview pane on the right. Fuzzel cannot do that,
# so this uses a dual-pane layout: fzf list (left) + imv full image (right).

set -euo pipefail

export PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}/bin:$PATH"

format_name() {
  local name=$1
  name="${name##*/}"
  printf '%s\n' "$name" | sed -E 's/^([0-9]+-?)//; s/\.[^.]+$//; s/-/ /g; s/(^|[[:space:]])(.)/\1\U\2/g'
}

collect_backgrounds() {
  labels=()
  paths=()
  declare -gA seen_files=()

  local theme_name="" wallpaper_dir background filename label
  if [[ -f "$HOME/.config/omarchy/current/theme.name" ]]; then
    theme_name="$(<"$HOME/.config/omarchy/current/theme.name")"
  fi

  local dirs=("$HOME/.config/omarchy/current/theme/backgrounds")
  if [[ -n $theme_name ]]; then
    dirs+=("$HOME/.config/omarchy/backgrounds/$theme_name")
  fi

  for wallpaper_dir in "${dirs[@]}"; do
    [[ -d "$wallpaper_dir" ]] || continue

    while IFS= read -r background; do
      filename="${background##*/}"
      [[ -n ${seen_files[$filename]:-} ]] && continue
      seen_files[$filename]=1

      label="$(format_name "$filename")"
      labels+=("$label")
      paths+=("$background")
    done < <(find -L "$wallpaper_dir" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp' \) | sort)
  done
}

client_address_for_pid() {
  local pid=$1 i addr
  for i in $(seq 1 50); do
    addr=$(hyprctl clients -j 2>/dev/null | jq -r --argjson p "$pid" '.[] | select(.pid == $p) | .address' | head -1)
    if [[ -n $addr && $addr != null ]]; then
      printf '%s\n' "$addr"
      return 0
    fi
    sleep 0.05
  done
  return 1
}

client_address_for_class() {
  local class=$1 i addr
  for i in $(seq 1 50); do
    addr=$(hyprctl clients -j 2>/dev/null | jq -r --arg c "$class" '
      .[] | select(.class == $c or .initialClass == $c) | .address
    ' | head -1)
    if [[ -n $addr && $addr != null ]]; then
      printf '%s\n' "$addr"
      return 0
    fi
    sleep 0.05
  done
  return 1
}

position_address() {
  local addr=$1 x=$2 y=$3 w=$4 h=$5
  [[ -n $addr && $addr != null ]] || return 1
  hyprctl dispatch setfloating "address:$addr" >/dev/null 2>&1 || true
  hyprctl dispatch resizewindowpixel "exact $w $h,address:$addr" >/dev/null 2>&1 || true
  hyprctl dispatch movewindowpixel "exact $x $y,address:$addr" >/dev/null 2>&1 || true
}

position_pid() {
  local pid=$1 x=$2 y=$3 w=$4 h=$5 addr
  addr=$(client_address_for_pid "$pid") || return 1
  position_address "$addr" "$x" "$y" "$w" "$h"
}

focused_monitor_geometry() {
  # Logical pixels (physical / scale) for reliable window placement
  hyprctl monitors -j 2>/dev/null | jq -r '
    (map(select(.focused == true)) + .)[0]
    | "\(.x | floor) \(.y | floor) \((.width / .scale) | floor) \((.height / .scale) | floor)"
  ' | head -1
}

layout_slots() {
  # Sets list_* and prev_* globals from focused monitor
  local mx my mw mh
  read -r mx my mw mh <<<"$(focused_monitor_geometry)"
  if [[ -z ${mw:-} || $mw -lt 100 ]]; then
    return 1
  fi

  # List left ~32%, large preview right ~58%
  list_w=$((mw * 32 / 100))
  list_h=$((mh * 72 / 100))
  list_x=$((mx + mw * 4 / 100))
  list_y=$((my + mh * 14 / 100))

  prev_w=$((mw * 58 / 100))
  prev_h=$((mh * 72 / 100))
  prev_x=$((mx + mw * 40 / 100))
  prev_y=$((my + mh * 14 / 100))
}

# imv-only fallback: full-window browse, Enter sets wallpaper
run_imv_only_picker() {
  if omarchy-cmd-missing imv; then
    notify-send "Background selector" "Install imv for wallpaper previews"
    exit 1
  fi

  imv -c "
    bind Return exec omarchy-theme-bg-set \"\$imv_current_file\"; quit
    bind Escape quit
    bind q quit
    overlay
  " "${paths[@]}"
}

run_dual_pane_picker() {
  if omarchy-cmd-missing imv || omarchy-cmd-missing fzf || omarchy-cmd-missing jq; then
    run_imv_only_picker
    return
  fi

  if ! command -v hyprctl >/dev/null 2>&1 || ! layout_slots; then
    run_imv_only_picker
    return
  fi

  # Full-size image preview on the right
  imv -c "
    bind Escape quit
    bind q quit
    overlay
  " "${paths[@]}" >/dev/null 2>&1 &
  local imv_pid=$!

  position_pid "$imv_pid" "$prev_x" "$prev_y" "$prev_w" "$prev_h" || true

  cleanup() {
    imv-msg "$imv_pid" quit >/dev/null 2>&1 || kill "$imv_pid" >/dev/null 2>&1 || true
  }
  trap cleanup EXIT

  # Position this terminal (list pane) on the left when we have an app-id
  local term_addr
  term_addr=$(client_address_for_class "org.omarchy.bgpicker" 2>/dev/null || true)
  if [[ -n ${term_addr:-} ]]; then
    position_address "$term_addr" "$list_x" "$list_y" "$list_w" "$list_h" || true
  fi

  # Left-side name list; focus updates the imv preview (fzf {n} is 0-based)
  local selected path
  selected=$(
    for i in "${!labels[@]}"; do
      printf '%s\t%s\n' "${labels[$i]}" "${paths[$i]}"
    done | fzf \
      --delimiter=$'\t' \
      --with-nth=1 \
      --prompt='Background › ' \
      --header='↑↓ preview · Enter apply · Esc cancel' \
      --preview-window=hidden \
      --height=100% \
      --border \
      --reverse \
      --bind "focus:execute-silent(bash -c 'imv-msg \"\$0\" goto \$((\$1 + 1))' $imv_pid {n})" \
      || true
  )

  trap - EXIT

  if [[ -n $selected ]]; then
    path="${selected#*$'\t'}"
    # Paths may contain spaces (user backgrounds); always quote the test.
    if [[ -f "$path" ]]; then
      omarchy-theme-bg-set "$path"
    fi
  fi

  cleanup
}

main() {
  collect_backgrounds

  if ((${#paths[@]} == 0)); then
    notify-send "Background selector" "No backgrounds found for the current theme"
    exit 1
  fi

  # Nested terminal entry (has TTY for fzf)
  if [[ ${1:-} == --in-terminal ]]; then
    run_dual_pane_picker
    exit 0
  fi

  # From Super+Ctrl+Space / menu: no TTY — open floating terminal for list pane
  if [[ ! -t 0 || ! -t 1 ]]; then
    if omarchy-cmd-present xdg-terminal-exec; then
      local inner
      inner="export PATH=$(printf '%q' "$PATH"); $(printf '%q' "${BASH_SOURCE[0]}") --in-terminal"
      local spawn_pid=""
      if command -v uwsm-app >/dev/null 2>&1; then
        setsid uwsm-app -- xdg-terminal-exec --app-id=org.omarchy.bgpicker --title="Background" \
          -e bash -lc "$inner" >/dev/null 2>&1 &
        spawn_pid=$!
      else
        setsid xdg-terminal-exec --app-id=org.omarchy.bgpicker --title="Background" \
          -e bash -lc "$inner" >/dev/null 2>&1 &
        spawn_pid=$!
      fi
      # If the terminal dies immediately, fall back instead of silent exit 0
      sleep 0.4
      if [[ -n $spawn_pid ]] && kill -0 "$spawn_pid" 2>/dev/null; then
        exit 0
      fi
      notify-send "Background selector" "Terminal picker failed; using image browser" 2>/dev/null || true
    fi
    run_imv_only_picker
    exit 0
  fi

  run_dual_pane_picker
}

main "$@"
