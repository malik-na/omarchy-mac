#!/bin/bash

# omarchy:summary=Dismiss stuck fuzzel instances (fuzzel is on-demand, not a daemon)
# omarchy:examples=omarchy restart fuzzel

# Unlike Walker, fuzzel does not stay running as a service. Super+Space /
# Super+Alt+Space spawn a new process each time. "Restart" clears any hung
# instances and confirms the launcher is ready.

killed=0
if pgrep -x fuzzel >/dev/null 2>&1; then
  pkill -x fuzzel 2>/dev/null || true
  killed=1
fi

if ((killed)); then
  notify-send -u low "Fuzzel" "Closed open launcher windows"
  echo "Closed open fuzzel instances."
else
  notify-send -u low "Fuzzel" "Launcher ready — Super+Space / Super+Alt+Space"
  echo "Fuzzel is on-demand (not a background service)."
  echo "Open it with Super+Space (apps) or Super+Alt+Space (Omarchy menu)."
fi
