#!/bin/bash
# omarchy:summary=Send a test low-battery notification
# omarchy:hidden=true

# Send a visible low-battery test notification.
#
# The former --service mode exercised a systemd battery-monitor path with a
# now-removed helper; battery logic consolidated into omarchy-battery-status,
# so only the direct notification remains.

LEVEL="${1:-10}"

if [[ ! $LEVEL =~ ^[0-9]+$ ]]; then
  echo "Usage: omarchy-cmd-test-battery-notification [level]"
  exit 1
fi

notify-send -u critical "󱐋 Time to recharge!" "Battery is down to ${LEVEL}%" -i battery-caution -t 30000
