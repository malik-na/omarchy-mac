#!/bin/bash

# omarchy:summary=Guided end-to-end Omarchy Mac install: boot layout, encryption, Omarchy
# omarchy:group=setup
# omarchy:requires-sudo=true
# omarchy:args=[--encrypt|--no-encrypt] [--user <name>] [--hostname <name>] [--repo <owner/repo>] [--ref <branch>] [--status] [--step <name>] [--fonts] [--autologin] [--resume] [--abort] [--allow-omarchy3]
# omarchy:examples=sudo omarchy-mac-setup --encrypt | omarchy-mac-setup --status

# One command, run once as root on a fresh Asahi Alarm install, that carries the
# machine all the way to a booted Omarchy desktop. It asks its questions up
# front, then drives the steps across the reboots each one needs, resuming
# itself on every boot until the machine is done:
#
#   1. BOOT LAYOUT  Asahi Alarm's btrfs images keep /boot on the root
#      filesystem, where GRUB cannot read it once the root is encrypted. The
#      EFI partition is mounted at /boot instead.       (reboot)
#   2. ENCRYPTION   The root is encrypted in place. You choose the disk
#      passphrase at the console on the boot that does the work, and enter it
#      on every boot after.                              (reboot)
#   3. OMARCHY      The repo is cloned and install.sh runs as your user.
#                                                        (reboot into Omarchy)
#
# The only thing you type after starting it is the disk passphrase.
#
# Each step is done by the tool that owns it -- omarchy-system-boot-to-esp and
# omarchy-system-btrfs-migrate -- from a checkout this script makes. Where the
# machine has got to is read from the machine itself (is /boot separate, is the
# root a dm-crypt device, does @factory exist), so an interrupted run picks up
# where it left off rather than repeating work.

set -euo pipefail

CONF=/etc/omarchy-mac-setup.conf
SELF=/usr/local/bin/omarchy-mac-setup
UNIT=/etc/systemd/system/omarchy-mac-setup.service
SUDOERS=/etc/sudoers.d/01-omarchy-mac-setup
SRC=/var/lib/omarchy-mac-setup/src
LOG=/var/log/omarchy-mac-setup.log

# Upstream, on the branch this is published from. The defaults have to name a
# branch that actually carries this script and the two tools it drives, and the
# check below refuses to install Omarchy 3 unasked -- so if this runs before
# the merge that puts Quattro on main, it stops with a message naming the
# branch to pass instead rather than installing the wrong generation.
DEFAULT_REPO=malik-na/omarchy-mac
DEFAULT_REF=main

# Everything this script shells out to, and therefore everything the chosen
# branch has to contain.
REQUIRED_TOOLS=(omarchy-system-boot-to-esp omarchy-system-btrfs-migrate)

# quickshell's AUR source, and the mirror the project publishes itself.
QUICKSHELL_UPSTREAM=https://git.outfoxxed.me/quickshell/
QUICKSHELL_MIRROR=https://github.com/quickshell-mirror/

log() {
  printf '\033[32m==>\033[0m %s\n' "$*"
}

warn() {
  printf '\033[33mWarning:\033[0m %s\n' "$*" >&2
}

fail() {
  printf '\033[31mError:\033[0m %s\n' "$*" >&2
  exit 1
}

banner() {
  printf '\n\033[36m=== %s ===\033[0m\n\n' "$*"
}

# ---------------------------------------------------------------------------
# State, read from the machine rather than remembered
# ---------------------------------------------------------------------------

root_source() {
  findmnt -no SOURCE / | sed 's/\[.*\]//'
}

# /boot has to be its own (unencrypted) partition before the root can be
# encrypted, or GRUB loses its modules and kernel behind the LUKS header.
boot_is_separate() {
  local boot
  boot=$(findmnt -no SOURCE /boot 2>/dev/null | sed 's/\[.*\]//') || return 1
  [[ -n $boot && $boot != "$(root_source)" ]]
}

# A dm-crypt root is not the same as a finished one: an interrupted pass leaves
# a mapped device whose LUKS2 header still records the reencryption. Treating
# that as done would move on to the install while the encryption is unfinished.
root_is_encrypted() {
  local source backing
  source=$(root_source)
  [[ $(lsblk -no TYPE "$source" 2>/dev/null) == "crypt" ]] || return 1

  backing=$(lsblk -nsplo NAME,TYPE "$source" 2>/dev/null |
    awk '$2 == "part" {print $1; exit}')
  if [[ -n $backing ]] && cryptsetup luksDump "$backing" 2>/dev/null | grep -q 'online-reencrypt'; then
    return 1
  fi
  return 0
}

current_hostname() {
  local name
  name=$(hostnamectl --static 2>/dev/null) || name=""
  [[ -n $name ]] || name=$(cat /etc/hostname 2>/dev/null || true)
  [[ -n $name ]] || name=$(uname -n)
  printf '%s' "$name"
}

# RFC 1123: each dot-separated label is 1–63 characters of letters, digits and
# hyphens, and cannot start or end with a hyphen. Dots are allowed so a fully
# qualified name can be given.
valid_hostname() {
  local name="$1"
  [[ -n $name ]] || return 1
  (( ${#name} <= 253 )) || return 1
  [[ $name =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$ ]]
}

# Keep the name resolving locally as well: sudo warns about an unresolvable
# host, and plenty of desktop software looks itself up. 127.0.1.1 is where a
# machine's own name goes when it is not a real network address.
ensure_hosts_entry() {
  local name="$1" short=${1%%.*} entry
  if [[ $name == "$short" ]]; then
    entry=$name
  else
    entry="$name $short"
  fi

  if grep -qE '^127\.0\.1\.1[[:space:]]' /etc/hosts; then
    sed -i "s|^127\.0\.1\.1[[:space:]].*|127.0.1.1\t$entry|" /etc/hosts
  else
    printf '127.0.1.1\t%s\n' "$entry" >>/etc/hosts
  fi
}

apply_hostname() {
  local name="$1"
  [[ -n $name ]] || return 0
  [[ $name != "$(current_hostname)" ]] || return 0

  log "Setting hostname to $name"
  hostnamectl set-hostname "$name" 2>/dev/null || printf '%s\n' "$name" >/etc/hostname
  ensure_hosts_entry "$name"
}

# install.sh snapshots the finished system as @factory on its way out, so the
# subvolume is proof the install ran to completion.
omarchy_is_installed() {
  btrfs subvolume list / 2>/dev/null | awk '{print $NF}' | grep -qx '@factory'
}

# Pure: given the machine's state and what the user asked for, name the next
# step. Kept side-effect free so the tests can walk the whole matrix.
next_step() {
  local boot_separate="$1" encrypted="$2" want_encrypt="$3" installed="$4"

  if [[ $installed == 1 ]]; then
    echo done
  elif [[ $want_encrypt == 1 && $encrypted != 1 ]]; then
    if [[ $boot_separate == 1 ]]; then
      echo encrypt
    else
      echo boot-layout
    fi
  else
    echo omarchy
  fi
}

current_step() {
  local boot_separate=0 encrypted=0 installed=0
  boot_is_separate && boot_separate=1
  root_is_encrypted && encrypted=1
  omarchy_is_installed && installed=1
  next_step "$boot_separate" "$encrypted" "$want_encrypt" "$installed"
}

# ---------------------------------------------------------------------------
# Persistence: the answers, this script, and the unit that resumes it
# ---------------------------------------------------------------------------

load_conf() {
  # Plain defaults, not environment fallbacks: USERNAME and friends are already
  # set in a login shell and would quietly pick the wrong answers.
  want_encrypt=1
  username=""
  hostname=""
  repo=$DEFAULT_REPO
  ref=$DEFAULT_REF

  if [[ -f $CONF ]]; then
    # shellcheck source=/dev/null
    . "$CONF"
    want_encrypt=${WANT_ENCRYPT:-$want_encrypt}
    username=${SETUP_USER:-$username}
    hostname=${SETUP_HOSTNAME:-$hostname}
    repo=${SETUP_REPO:-$repo}
    ref=${SETUP_REF:-$ref}
  fi
}

save_conf() {
  cat >"$CONF" <<EOF
# Written by omarchy-mac-setup; delete it to stop the guided install.
WANT_ENCRYPT=$want_encrypt
SETUP_USER=$username
SETUP_HOSTNAME=$hostname
SETUP_REPO=$repo
SETUP_REF=$ref
EOF
  chmod 600 "$CONF"
}

install_self() {
  if [[ ${BASH_SOURCE[0]} -ef $SELF ]]; then
    return 0
  fi
  install -Dm755 "${BASH_SOURCE[0]}" "$SELF"
}

# The unit takes over tty1 so the next step runs, and can be watched, without
# anyone logging in. Conflicting with the getty keeps the two off each other's
# console.
install_unit() {
  cat >"$UNIT" <<EOF
[Unit]
Description=Omarchy Mac guided setup
ConditionPathExists=$CONF
After=network-online.target systemd-user-sessions.service
After=omarchy-btrfs-migrate-finish.service
Conflicts=getty@tty1.service

[Service]
Type=oneshot
ExecStart=$SELF --resume
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
# The Omarchy step compiles AUR packages for the better part of an hour, and a
# timeout that killed it mid-build would leave a half-installed machine. The
# bounds that matter live in the script: the network wait gives up after 15
# minutes, and each step either finishes or fails.
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable omarchy-mac-setup.service >/dev/null 2>&1
}

cleanup_all() {
  rm -f "$CONF" "$SUDOERS"
  if [[ -f $UNIT ]]; then
    systemctl disable omarchy-mac-setup.service >/dev/null 2>&1 || true
    rm -f "$UNIT"
    systemctl daemon-reload
  fi
  systemctl start getty@tty1.service >/dev/null 2>&1 || true
}

# The unit conflicts with getty@tty1 so the two do not fight over the console,
# which means a step that dies leaves tty1 with no login -- on the machine whose
# setup just failed. Every exit puts the getty back; during a reboot it is
# harmless, and outside one it is the difference between a visible prompt and a
# console that looks dead.
restore_console() {
  systemctl start getty@tty1.service >/dev/null 2>&1 || true
}

# Wi-Fi and Bluetooth drivers retry loudly on these machines, and their
# messages land on the same console the setup is printing to. Quiet it while
# the setup owns tty1; the messages still reach the kernel log, and the level
# goes back on the way out.
quiet_console() {
  [[ -w /proc/sys/kernel/printk ]] || return 0
  read -r SAVED_PRINTK _ </proc/sys/kernel/printk || SAVED_PRINTK=""
  echo 3 >/proc/sys/kernel/printk 2>/dev/null || true
}

restore_printk() {
  [[ -n ${SAVED_PRINTK:-} ]] || return 0
  echo "$SAVED_PRINTK" >/proc/sys/kernel/printk 2>/dev/null || true
}

on_exit() {
  revoke_passwordless_sudo
  restore_printk
  restore_console
}

reboot_now() {
  local reason="$1"
  log "$reason"
  log "Rebooting in 5 seconds; the setup continues automatically on tty1."
  sleep 5
  systemctl reboot
}

# ---------------------------------------------------------------------------
# Prerequisites
# ---------------------------------------------------------------------------

have_network() {
  ip route 2>/dev/null | grep -q '^default '
}

require_network() {
  have_network && return 0

  warn "No default route -- the install needs the network."
  warn "Connect with 'nmtui' on another console (Ctrl+Alt+F2), then come back."
  local waited=0
  while ! have_network; do
    sleep 10
    (( waited += 10 ))
    (( waited % 60 == 0 )) && log "Still waiting for the network ($((waited / 60))m)"
    (( waited > 900 )) && fail "no network after 15 minutes; run '$SELF --resume' when it is up"
  done
  log "Network is up."
}

# A Retina panel renders the kernel's 8x16 console font at about a millimetre
# tall, and GRUB's built-in font is no better — which is a problem, because the
# console is where the disk passphrase is typed and the GRUB editor is where
# you end up when a boot has gone wrong. Both are set to something legible
# before the first reboot.
setup_console_font() {
  command -v setfont >/dev/null || return 0

  if ! pacman -Sy --noconfirm --needed terminus-font >/dev/null 2>&1; then
    warn "Could not install terminus-font; leaving the console font alone."
    return 0
  fi

  touch /etc/vconsole.conf
  if grep -q '^FONT=' /etc/vconsole.conf; then
    sed -i 's|^FONT=.*|FONT=ter-132b|' /etc/vconsole.conf
  else
    printf 'FONT=ter-132b\n' >>/etc/vconsole.conf
  fi

  # Immediately, so the rest of this run is readable too. The initramfs picks
  # it up from vconsole.conf at the next mkinitcpio, which the encryption step
  # runs anyway — so the passphrase prompt gets it as well.
  setfont ter-132b 2>/dev/null || true
}

setup_grub_font() {
  local ttf out=/boot/grub/fonts/unicode32.pf2 candidate
  command -v grub-mkfont >/dev/null || {
    warn "grub-mkfont is missing; leaving the GRUB font alone"
    return 0
  }

  # A minimal Arch has no DejaVu, and silently giving up here is how the menu
  # stayed unreadable on a machine that had run this. Try what Omarchy
  # installs, then anything, then install DejaVu rather than skip.
  for candidate in \
    /usr/share/fonts/TTF/DejaVuSansMono.ttf \
    /usr/share/fonts/ttf-jetbrains-mono-nerd/JetBrainsMonoNerdFont-Regular.ttf; do
    [[ -f $candidate ]] && ttf=$candidate && break
  done

  if [[ -z ${ttf:-} ]]; then
    ttf=$(find /usr/share/fonts -name '*Mono*.ttf' -print -quit 2>/dev/null || true)
  fi
  if [[ -z $ttf ]]; then
    pacman -Sy --noconfirm --needed ttf-dejavu >/dev/null 2>&1 || true
    ttf=$(find /usr/share/fonts -name 'DejaVuSansMono.ttf' -print -quit 2>/dev/null || true)
  fi
  if [[ -z $ttf ]]; then
    warn "No TrueType font to build a GRUB font from; the menu keeps its size"
    return 0
  fi

  mkdir -p "$(dirname "$out")"
  if ! grub-mkfont -s 32 -o "$out" "$ttf"; then
    warn "grub-mkfont failed on $ttf; the menu keeps its size"
    return 0
  fi

  if grep -q '^GRUB_FONT=' /etc/default/grub 2>/dev/null; then
    sed -i "s|^GRUB_FONT=.*|GRUB_FONT=$out|" /etc/default/grub
  else
    printf 'GRUB_FONT=%s\n' "$out" >>/etc/default/grub
  fi

  # GRUB_FONT is only a setting until grub.cfg is regenerated -- that is where
  # the loadfont line lives.
  if [[ -f /boot/grub/grub.cfg ]]; then
    grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 ||
      warn "could not regenerate grub.cfg; the GRUB menu keeps its old font"
  fi
  log "GRUB font built from $ttf at 32px"
}

ensure_source_checkout() {
  [[ -d $SRC/.git ]] && return 0

  command -v git >/dev/null || pacman -Sy --noconfirm --needed git
  mkdir -p "$(dirname "$SRC")"
  log "Fetching $repo ($ref)"
  # Shallow: this checkout only supplies the two tools and is thrown away. The
  # user's own checkout below is cloned in full, because it stays as the live
  # Omarchy install that `omarchy update` pulls into.
  git clone --branch "$ref" --depth 1 "https://codeberg.org/$repo.git" "$SRC" ||
    fail "could not clone $repo at $ref"
  check_omarchy_generation
  require_tools_present "$SRC"
}

# A branch can be a perfectly good Omarchy 4 branch and still not carry these
# tools -- malik-na/quattro does not, today. Catching that here, before anything
# is installed on the machine, turns a unit that fails on every boot into one
# clear message.
require_tools_present() {
  local dir="$1" tool
  for tool in "${REQUIRED_TOOLS[@]}"; do
    [[ -f $dir/bin/$tool ]] ||
      fail "$repo ($ref) has no bin/$tool -- wrong branch? Pass --repo/--ref."
  done
}

# Until quattro is merged into main, main is still the Omarchy 3.x line -- and
# its install.sh installs Omarchy 3 without ever announcing which generation it
# is. Say the version out loud, and stop rather than silently deliver 3.x to
# someone who came here for 4.
check_omarchy_generation() {
  local version
  version=$(head -1 "$SRC/version" 2>/dev/null || echo unknown)
  log "This is Omarchy $version ($repo, branch $ref)"

  if [[ $version == "unknown" || -z $version ]]; then
    warn "$repo ($ref) has no version file -- cannot tell which Omarchy this is."
  fi

  if [[ $version == 3.* ]] && (( ! allow_omarchy3 )); then
    warn "Branch '$ref' of $repo is the Omarchy 3.x line."
    warn "For Omarchy 4 pass a quattro-line branch: --ref quattro, until that"
    warn "is merged into $DEFAULT_REF."
    fail "refusing to install Omarchy 3 unasked; pass --allow-omarchy3 if you meant it"
  fi
}

# ---------------------------------------------------------------------------
# The steps
# ---------------------------------------------------------------------------

step_boot_layout() {
  banner "Step 1 of 3 -- boot layout"
  log "/boot is on the root filesystem, where GRUB cannot reach it once the"
  log "root is encrypted. Moving it onto the EFI partition."
  bash "$SRC/bin/omarchy-system-boot-to-esp" --yes
  reboot_now "Boot layout done."
}

step_encrypt() {
  banner "Step 2 of 3 -- disk encryption"
  log "Staging the in-place encryption of the root filesystem."
  log "On the next boot you will CHOOSE THE DISK PASSPHRASE at this console,"
  log "and the whole partition is rewritten -- that part takes a while and"
  log "prints nothing. Do not power the machine off during it."
  bash "$SRC/bin/omarchy-system-btrfs-migrate" --encrypt --yes
  reboot_now "Encryption staged."
}

# Ordinary, permanent sudo for the wheel group -- the arrangement the user needs
# for the rest of the machine's life, and what the manual instructions set up
# by hand. Kept separate from the temporary NOPASSWD rule below so neither one
# hides inside the other.
ensure_wheel_sudo() {
  printf '%%wheel ALL=(ALL:ALL) ALL\n' >/etc/sudoers.d/00-wheel
  chmod 440 /etc/sudoers.d/00-wheel
}

ensure_user() {
  ensure_wheel_sudo
  id -u "$username" >/dev/null 2>&1 && return 0

  log "Creating user $username"
  useradd -m -G wheel -s /bin/bash "$username"
  log "Set a password for $username:"
  until passwd "$username"; do
    warn "Try again."
  done
}

# install.sh runs as the user and calls sudo throughout, with nobody at the
# keyboard to answer. This rule makes that possible and is removed the moment
# the install returns -- including when it fails, which is why every exit from
# step_omarchy goes through revoke_passwordless_sudo.
grant_passwordless_sudo() {
  printf '%s ALL=(ALL:ALL) NOPASSWD: ALL\n' "$username" >"$SUDOERS"
  chmod 440 "$SUDOERS"
}

revoke_passwordless_sudo() {
  rm -f "$SUDOERS"
}

# The Omarchy install regenerates the initramfs, and its HOOKS come from a
# drop-in written for x86. An image built without the asahi hook does not boot
# this hardware — it wedges in the initramfs, keyboard included, which is only
# discoverable by rebooting into it. Check before that reboot, while there is
# still a shell to fix it from.
# The HOOKS the next mkinitcpio run will use: its config, then the drop-ins in
# the order mkinitcpio sources them -- which is where a later file assigning
# HOOKS outright overrides everything before it.
effective_hooks() {
  local conf=${OMARCHY_MKINITCPIO_CONF:-/etc/mkinitcpio.conf}
  local confd=${OMARCHY_MKINITCPIO_CONFD:-/etc/mkinitcpio.conf.d}

  bash -c '
    HOOKS=(); MODULES=(); FILES=(); BINARIES=()
    [[ -f $1 ]] && source "$1"
    for _conf in "$2"/*.conf; do
      [[ -f $_conf ]] && source "$_conf"
    done
    printf "%s\n" "${HOOKS[*]}"
  ' -- "$conf" "$confd" 2>/dev/null
}

hooks_include_asahi() {
  [[ " $(effective_hooks) " == *" asahi "* ]]
}


# Omarchy enables SDDM but leaves autologin to the x86 ISO's provisioning step,
# which never runs on a Mac: install/login/sddm.sh says outright that "the ISO
# owns autologin/session state because it knows whether the target is
# encrypted". Without it you land on a greeter that was never configured with a
# username field, which looks exactly like a login refusing your password.
#
# The ISO's rule for an encrypted machine is autologin, permanently: the disk
# passphrase at boot is the authentication, and asking for a second password
# afterwards protects nothing that the first one did not.
configure_autologin() {
  local user="$1"

  command -v sddm >/dev/null || return 0
  [[ -f /usr/share/wayland-sessions/omarchy.desktop ]] ||
    warn "omarchy.desktop session is missing; autologin may land nowhere"

  mkdir -p /etc/sddm.conf.d /var/lib/sddm
  printf '[Autologin]\nUser=%s\nSession=omarchy.desktop\n' "$user" \
    >/etc/sddm.conf.d/autologin.conf
  printf '[Last]\nSession=omarchy.desktop\nUser=%s\n' "$user" \
    >/var/lib/sddm/state.conf
  log "SDDM will log $user straight in; the disk passphrase is the authentication"
}
verify_initramfs() {
  # Asking the config rather than the built image: the config is what the build
  # reads, and reading an image back means parsing whatever lsinitcpio prints
  # today -- which failed a perfectly good initramfs once already.
  [[ -e /usr/lib/initcpio/install/asahi ]] || return 0

  if hooks_include_asahi; then
    log "Initramfs hooks include asahi"
    return 0
  fi

  warn "The initramfs hooks do not include asahi, which stages this machine's"
  warn "firmware. An image built without it hangs before login."
  log "Rebuilding it"
  if ! mkinitcpio -P; then
    fail "could not rebuild the initramfs; do not reboot until asahi is in HOOKS"
  fi
  hooks_include_asahi ||
    fail "asahi is still missing from HOOKS -- check /etc/mkinitcpio.conf.d/"
}

# quickshell-git is the only AUR package for the Quattro shell, and its source
# is one self-hosted git server. When that server is down the build fails and
# takes the whole desktop with it -- there is no Quattro without quickshell.
# The project publishes an official GitHub mirror; use it, but only when
# upstream is genuinely unreachable, and say so rather than quietly building
# from somewhere the PKGBUILD did not name.
ensure_quickshell_source() {
  # -H and -C /: sudo otherwise keeps root's HOME, and git run as another user
  # from /root dies discovering a repository in a directory it cannot read
  # ("fatal: error reading '/root/.git'") before it reaches --global at all.
  local user="$1"

  if sudo -u "$user" -H git -C / config --global --get-regexp 'url\..*\.insteadof' 2>/dev/null |
    grep -q quickshell; then
    return 0
  fi

  if timeout 30 git ls-remote --exit-code "${QUICKSHELL_UPSTREAM}quickshell.git" \
    >/dev/null 2>&1; then
    return 0
  fi

  warn "quickshell's upstream git ($QUICKSHELL_UPSTREAM) is unreachable."
  log "Building from the project's own GitHub mirror instead:"
  log "  $QUICKSHELL_MIRROR"
  log "Undo later with:"
  log "  git config --global --unset url.${QUICKSHELL_MIRROR}.insteadof"
  sudo -u "$user" -H git -C / config --global \
    "url.${QUICKSHELL_MIRROR}.insteadOf" "$QUICKSHELL_UPSTREAM"
}

step_omarchy() {
  banner "Step 3 of 3 -- installing Omarchy"
  require_network
  ensure_user

  local home
  home=$(getent passwd "$username" | cut -d: -f6)

  if [[ ! -d $home/.local/share/omarchy/.git ]]; then
    log "Cloning $repo ($ref) into $home/.local/share/omarchy"
    sudo -u "$username" mkdir -p "$home/.local/share"
    sudo -u "$username" -H git -C / clone --branch "$ref" \
      "https://codeberg.org/$repo.git" "$home/.local/share/omarchy"
  fi

  ensure_quickshell_source "$username"
  grant_passwordless_sudo

  log "Running install.sh as $username -- this takes a while (AUR builds)."
  # Run from a login shell so the install sees a normal user environment. The
  # status is captured rather than left to set -e: a failed install must still
  # give the NOPASSWD rule back before anything else happens.
  local status=0
  sudo -u "$username" -i bash -lc 'cd ~/.local/share/omarchy && bash install.sh' || status=$?
  revoke_passwordless_sudo
  (( status == 0 )) || fail "install.sh exited $status -- fix it and run '$SELF --resume'"

  configure_autologin "$username"
  verify_initramfs
  reboot_now "Omarchy installed."
}

step_done() {
  banner "Setup complete"
  cleanup_all
  log "Encryption: $(root_is_encrypted && echo "on ($(root_source))" || echo off)"
  log "/boot: $(findmnt -no SOURCE /boot 2>/dev/null || echo '(not separate)')"
  log "Log in as $username and enjoy Omarchy."
  log "You can delete /boot.old and $SRC when you are happy with the machine."
}


# --step runs one step by name, out of order and regardless of what the machine
# looks like: for re-running something that half-worked, or for a machine that
# finished installing before a step existed. The state machine decides the
# order on its own; this is the manual override.
STEPS=(boot-layout encrypt omarchy fonts autologin done)

run_named_step() {
  local step="$1"

  case $step in
    boot-layout | encrypt | omarchy)
      # These drive the tools from the checkout, which a machine that never ran
      # the guided setup will not have.
      [[ -d $SRC/.git ]] || { require_network; ensure_source_checkout; }
      run_step "$step"
      ;;
    fonts)
      setup_console_font
      setup_grub_font
      log "Reboot to see the GRUB menu at the new size."
      ;;
    autologin)
      [[ -n $username ]] || fail "no user recorded; pass --user <name>"
      id -u "$username" >/dev/null 2>&1 || fail "$username does not exist"
      configure_autologin "$username"
      log "Restart the greeter to see it: systemctl restart sddm"
      ;;
    done)
      step_done
      ;;
    *)
      fail "unknown step: $step (one of: ${STEPS[*]})"
      ;;
  esac
}
run_step() {
  local step="$1"
  case $step in
    boot-layout) step_boot_layout ;;
    encrypt) step_encrypt ;;
    omarchy) step_omarchy ;;
    done) step_done ;;
    *) fail "unknown step: $step" ;;
  esac
}

# ---------------------------------------------------------------------------

print_status() {
  local step
  step=$(current_step)
  banner "Omarchy Mac setup status"
  printf '  root            %s (%s)\n' "$(root_source)" \
    "$(root_is_encrypted && echo encrypted || echo "not encrypted")"
  printf '  /boot           %s\n' \
    "$(boot_is_separate && findmnt -no SOURCE /boot || echo "on the root filesystem")"
  printf '  omarchy         %s\n' \
    "$(omarchy_is_installed && echo installed || echo "not installed")"
  printf '  encryption      %s\n' "$( ((want_encrypt)) && echo requested || echo "not requested")"
  printf '  hostname        %s\n' "$(current_hostname)"
  printf '  next step       %s\n\n' "$step"
}

ask_questions() {
  local answer

  banner "Omarchy Mac setup"
  echo "This installs Omarchy on this machine, rebooting a few times on the way."
  echo "It asks everything now, then runs on its own."
  echo

  if [[ -z $encrypt_flag ]]; then
    read -rp "Encrypt the disk? [Y/n] " answer
    [[ ${answer,,} == n* ]] && want_encrypt=0 || want_encrypt=1
  fi

  while [[ -z $username ]]; do
    read -rp "Username to create (your everyday login): " username
    [[ $username =~ ^[a-z_][a-z0-9_-]*$ ]] || {
      warn "That is not a valid Linux username."
      username=""
    }
  done

  while [[ -z $hostname ]]; do
    read -rp "Hostname for this machine [$(current_hostname)]: " hostname
    [[ -n $hostname ]] || hostname=$(current_hostname)
    valid_hostname "$hostname" || {
      warn "That is not a valid hostname (letters, digits and hyphens)."
      hostname=""
    }
  done

  echo
  log "Plan:"
  log "  - name this machine $hostname"
  log "  - create $username (in wheel, with sudo) and set its password"
  ((want_encrypt)) && log "  - move /boot onto the EFI partition (if needed), then reboot"
  ((want_encrypt)) && log "  - encrypt the root -- you choose the passphrase at the console"
  log "  - install Omarchy from $repo ($ref) as $username"
  log "  - reboot into the desktop"
  echo
  read -rp "Start? [Y/n] " answer
  # A full conditional, not `[[ ... ]] && fail`: as the last statement of the
  # function that returns 1 on the yes path, and set -e turns that into a
  # silent exit at the call site.
  if [[ ${answer,,} == n* ]]; then
    fail "not started"
  fi
  return 0
}

main() {
  local resume=0 status=0 abort=0 step_only="" allow_omarchy3=0 encrypt_flag="" want_encrypt username hostname repo ref

  load_conf

  while (( $# )); do
    case $1 in
      --encrypt) encrypt_flag=1; want_encrypt=1 ;;
      --no-encrypt) encrypt_flag=0; want_encrypt=0 ;;
      --user) username=${2:?--user needs a name}; shift ;;
      --hostname) hostname=${2:?--hostname needs a name}; shift ;;
      --repo) repo=${2:?--repo needs owner/repo}; shift ;;
      --ref) ref=${2:?--ref needs a branch}; shift ;;
      --allow-omarchy3) allow_omarchy3=1 ;;
      --resume) resume=1 ;;
      --status) status=1 ;;
      --step) step_only=${2:?--step needs a name}; shift ;;
      --fonts) step_only=fonts ;;
      --autologin) step_only=autologin ;;
      --abort) abort=1 ;;
      -h | --help)
        sed -n '/^# One command/,/^# where it left off/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,3\}//'
        exit 0
        ;;
      *) fail "unknown argument: $1" ;;
    esac
    shift
  done

  if (( status )); then
    print_status
    exit 0
  fi

  (( EUID == 0 )) || fail "run as root (sudo $0)"

  trap on_exit EXIT
  quiet_console

  # One step by name, for re-running something rather than starting over.
  if [[ -n $step_only ]]; then
    run_named_step "$step_only"
    exit 0
  fi

  if (( abort )); then
    cleanup_all
    log "Guided setup stopped. Nothing already done was undone."
    exit 0
  fi

  [[ $(uname -m) == "aarch64" ]] || fail "this tool is for Apple Silicon (aarch64) installs"

  mkdir -p "$(dirname "$LOG")"

  if (( ! resume )); then
    ask_questions
    # The checkout comes first so a branch that is missing this script's tools
    # fails here, with nothing installed on the machine -- rather than after the
    # unit is enabled, where it would refuse the same way on every boot.
    require_network
    ensure_source_checkout
    ensure_user
    setup_console_font
    setup_grub_font
    apply_hostname "$hostname"
    save_conf
    install_self
    install_unit
  else
    # A resumed run has a checkout already, unless the first run was
    # interrupted before it finished cloning.
    [[ -d $SRC/.git ]] || { require_network; ensure_source_checkout; }
  fi

  run_step "$(current_step)"
}

# Sourcing the script exposes its functions to the tests without running
# anything; executing it does the work.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
